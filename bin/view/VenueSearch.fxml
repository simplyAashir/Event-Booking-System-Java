<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.VenueSearchController"
      spacing="20" style="-fx-padding: 20;">
   
   <Label text="🔍 Search Venues" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
   
   <!-- Search Filters -->
   <VBox spacing="15" style="-fx-background-color: #ecf0f1; -fx-padding: 20; -fx-border-radius: 10;">
      <Label text="Search Filters" style="-fx-font-size: 16; -fx-font-weight: bold;" />
      
      <GridPane hgap="15" vgap="15">
         <Label text="Location:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
         <TextField fx:id="locationField" promptText="City or area" GridPane.columnIndex="1" GridPane.rowIndex="0" />
         
         <Label text="Event Type:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
         <ComboBox fx:id="eventTypeCombo" promptText="Select event type" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         
         <Label text="Min Capacity:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
         <TextField fx:id="minCapacityField" promptText="e.g., 50" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         
         <Label text="Max Capacity:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
         <TextField fx:id="maxCapacityField" promptText="e.g., 500" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         
         <Label text="Max Price/Hour:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
         <TextField fx:id="maxPriceField" promptText="e.g., 200.00" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      </GridPane>
      
      <HBox spacing="10" alignment="CENTER_RIGHT">
         <Button fx:id="clearButton" text="Clear Filters" onAction="#handleClearFilters" 
                 style="-fx-background-color: #95a5a6; -fx-text-fill: white;" />
         <Button fx:id="searchButton" text="Search Venues" onAction="#handleSearch" 
                 style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" />
      </HBox>
   </VBox>
   
   <!-- Search Results -->
   <VBox spacing="10">
      <Label fx:id="resultsLabel" text="Enter search criteria and click 'Search Venues'" 
             style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;" />
      
      <ScrollPane fitToWidth="true" style="-fx-max-height: 400;">
         <VBox fx:id="resultsContainer" spacing="10" />
      </ScrollPane>
   </VBox>

</VBox>