<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ResetPasswordController">
   <children>
      <Label text="Reset Password" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      
      <Label text="Enter your new password" textFill="#7f8c8d" />
      
      <VBox spacing="10.0">
         <Label text="Reset Token" />
         <TextField fx:id="tokenField" promptText="Enter reset token from email" editable="false" />
         
         <Label text="New Password *" />
         <PasswordField fx:id="newPasswordField" promptText="Enter new password (min 6 characters)" />
         
         <Label text="Confirm Password *" />
         <PasswordField fx:id="confirmPasswordField" promptText="Confirm your new password" />
      </VBox>
      
      <Button fx:id="resetButton" mnemonicParsing="false" onAction="#handleResetPassword" prefHeight="35.0" prefWidth="200.0" style="-fx-background-color: #e67e22; -fx-text-fill: white;" text="Reset Password" />
      
      <Hyperlink fx:id="backToLoginLink" onAction="#handleBackToLogin" text="Back to Login" />
      
      <Label fx:id="messageLabel" textFill="#e74c3c" wrapText="true" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>